# Settings for `npm start` and `npm run seed:live`, the only commands that read .env.
# Copy this file to .env and fill it in. On Render, enter them in the dashboard instead.
#
# The Postgres address from Supabase: Connect > Session pooler (port 5432).
DATABASE_URL=
# Supabase: Project Settings > API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
